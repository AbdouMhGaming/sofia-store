generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("SOFIA_MYSQL_URL")
}

model User {
  id                 Int         @id @default(autoincrement())
  email              String      @unique @db.VarChar(190)
  passwordHash       String      @db.VarChar(255)
  mustChangePassword Boolean     @default(true)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  roles              UserRole[]
  sessions           Session[]
  movements          StockMovement[]
  audit              AuditLog[]
  imports            ImportBatch[]
  media              MediaAsset[]
  registerOpenings   RegisterSession[] @relation("RegisterOpenedBy")
  registerClosings   RegisterSession[] @relation("RegisterClosedBy")
  sales              Sale[]
  refunds            Refund[]
  posCancellations   PosCancellation[]
  orderEvents        WebOrderEvent[]
  @@map("users")
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique @db.VarChar(40)
  users UserRole[]
  @@map("roles")
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  tokenHash String   @id @db.VarChar(64)
  userId    Int
  csrfHash  String   @db.VarChar(64)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("sessions")
}

model SetupClaim {
  id        Int      @id
  createdAt DateTime @default(now())
  @@map("owner_setup_claim")
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique @db.VarChar(100)
  nameFr   String    @db.VarChar(150)
  nameAr   String    @db.VarChar(150)
  products Product[]
  @@map("categories")
}

model Product {
  id            Int            @id @default(autoincrement())
  slug          String         @unique @db.VarChar(190)
  nameFr        String         @db.VarChar(150)
  nameAr        String         @db.VarChar(150)
  descriptionFr String         @db.Text
  descriptionAr String         @db.Text
  categoryId    Int
  featured      Boolean        @default(false)
  status        String         @default("PREVIEW") @db.VarChar(20)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  @@index([status, categoryId])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  path      String  @db.VarChar(500)
  position  Int     @default(0)
  mediaId   String? @db.VarChar(36)
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([productId, position])
  @@map("product_images")
}

model Size {
  id       Int              @id @default(autoincrement())
  name     String           @unique @db.VarChar(30)
  variants ProductVariant[]
  @@map("sizes")
}

model Color {
  id       Int              @id @default(autoincrement())
  name     String           @unique @db.VarChar(60)
  variants ProductVariant[]
  @@map("colors")
}

model ProductVariant {
  id         Int             @id @default(autoincrement())
  productId  Int
  sizeId     Int
  colorId    Int
  sku        String          @unique @db.VarChar(80)
  barcode    String          @unique @db.VarChar(80)
  priceMinor Int
  costMinor  Int
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  size       Size            @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color      Color           @relation(fields: [colorId], references: [id], onDelete: Restrict)
  inventory  Inventory[]
  movements  StockMovement[]
  saleItems  SaleItem[]
  webOrderItems WebOrderItem[]
  @@unique([productId, sizeId, colorId])
  @@map("product_variants")
}

model Location {
  id        Int         @id @default(autoincrement())
  code      String      @unique @db.VarChar(40)
  name      String      @db.VarChar(150)
  inventory Inventory[]
  @@map("locations")
}

model Inventory {
  id         Int            @id @default(autoincrement())
  variantId  Int
  locationId Int
  onHand     Int            @default(0)
  reserved   Int            @default(0)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@unique([variantId, locationId])
  @@map("inventory")
}

model StockMovement {
  id          Int            @id @default(autoincrement())
  variantId   Int
  userId      Int
  quantity    Int
  kind        String         @db.VarChar(30)
  reason      String         @db.VarChar(500)
  requestId   String         @unique @db.VarChar(100)
  requestHash String         @db.VarChar(64)
  balanceAfter Int
  createdAt   DateTime       @default(now())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  saleItemId  Int?           @unique
  refundItemId Int?          @unique
  saleItem    SaleItem?      @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  refundItem  RefundItem?    @relation(fields: [refundItemId], references: [id], onDelete: Restrict)
  @@index([variantId, createdAt])
  @@map("stock_movements")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String   @db.VarChar(80)
  detail    String   @db.VarChar(500)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([createdAt])
  @@map("audit_logs")
}

model StoreSetting {
  key   String @id @db.VarChar(100)
  value String @db.Text
  @@map("store_settings")
}

model ImportBatch {
  requestId   String   @id @db.VarChar(100)
  requestHash String   @db.VarChar(64)
  userId      Int
  products    Int
  variants    Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("import_batches")
}

model MediaAsset {
  id           String         @id @db.VarChar(36)
  userId       Int
  name         String         @db.VarChar(190)
  originalPath String         @db.VarChar(500)
  objectPrefix String         @default("") @db.VarChar(500)
  contentType  String         @db.VarChar(40)
  status       String         @default("PENDING") @db.VarChar(20)
  width        Int            @default(0)
  height       Int            @default(0)
  bytes        Int            @default(0)
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  @@index([status, createdAt])
  @@map("media_assets")
}

model CashRegister {
  id               Int @id @default(autoincrement())
  code             String @unique @db.VarChar(40)
  name             String @db.VarChar(150)
  currentSessionId Int? @unique
  currentSession   RegisterSession? @relation("CurrentRegister", fields: [currentSessionId], references: [id], onDelete: Restrict)
  sessions         RegisterSession[] @relation("RegisterHistory")
  cancellations    PosCancellation[]
  @@map("cash_registers")
}

model RegisterSession {
  id               Int @id @default(autoincrement())
  registerId       Int
  openedById       Int
  closedById       Int?
  status           String @default("OPEN") @db.VarChar(20)
  openingMinor     Int
  openedAt         DateTime @default(now())
  closedAt         DateTime?
  expectedMinor    Int?
  countedMinor     Int?
  varianceMinor    Int?
  closeReason      String? @db.VarChar(500)
  openRequestId    String @unique @db.VarChar(100)
  openRequestHash  String @db.VarChar(64)
  closeRequestId   String? @unique @db.VarChar(100)
  closeRequestHash String? @db.VarChar(64)
  register         CashRegister @relation("RegisterHistory", fields: [registerId], references: [id], onDelete: Restrict)
  currentFor       CashRegister? @relation("CurrentRegister")
  openedBy         User @relation("RegisterOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy         User? @relation("RegisterClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  sales            Sale[]
  refunds          Refund[]
  @@index([openedById, openedAt])
  @@map("register_sessions")
}

model Sale {
  id                Int @id @default(autoincrement())
  number            String @unique @db.VarChar(80)
  requestId         String @unique @db.VarChar(100)
  requestHash       String @db.VarChar(64)
  registerSessionId Int
  userId            Int
  status            String @default("COMPLETED") @db.VarChar(30)
  subtotalMinor     Int
  discountMinor     Int
  discountReason    String @default("") @db.VarChar(500)
  totalMinor        Int
  storeName         String @db.VarChar(150)
  storeAddress      String @default("") @db.VarChar(500)
  storePhone        String @default("") @db.VarChar(60)
  receiptFooter     String @default("") @db.VarChar(500)
  createdAt         DateTime @default(now())
  registerSession   RegisterSession @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)
  user              User @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             SaleItem[]
  payment           Payment?
  refunds           Refund[]
  @@index([userId, id])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id             Int @id @default(autoincrement())
  saleId         Int
  variantId      Int
  productName    String @db.VarChar(150)
  nameAr         String @db.VarChar(150)
  sku            String @db.VarChar(80)
  barcode        String @db.VarChar(80)
  size           String @db.VarChar(30)
  color          String @db.VarChar(60)
  quantity       Int
  unitPriceMinor Int
  unitCostMinor  Int
  discountMinor  Int
  lineTotalMinor Int
  sale           Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  refundItems    RefundItem[]
  movement       StockMovement?
  @@unique([saleId, variantId])
  @@map("sale_items")
}

model Payment {
  id            Int @id @default(autoincrement())
  saleId        Int @unique
  method        String @default("CASH") @db.VarChar(20)
  amountMinor   Int
  tenderedMinor Int
  changeMinor   Int
  createdAt     DateTime @default(now())
  sale          Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  @@map("payments")
}

model Refund {
  id                Int @id @default(autoincrement())
  number            String @unique @db.VarChar(80)
  requestId         String @unique @db.VarChar(100)
  requestHash       String @db.VarChar(64)
  saleId            Int
  registerSessionId Int
  userId            Int
  kind              String @db.VarChar(20)
  reason            String @db.VarChar(500)
  amountMinor       Int
  createdAt         DateTime @default(now())
  sale              Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  registerSession   RegisterSession @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)
  user              User @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             RefundItem[]
  @@index([saleId, id])
  @@map("refunds")
}

model RefundItem {
  id           Int @id @default(autoincrement())
  refundId     Int
  saleItemId   Int
  quantity     Int
  restock      Boolean
  amountMinor  Int
  refund       Refund @relation(fields: [refundId], references: [id], onDelete: Restrict)
  saleItem     SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  movement     StockMovement?
  @@unique([refundId, saleItemId])
  @@index([saleItemId])
  @@map("refund_items")
}

model PosCancellation {
  kind       String @db.VarChar(20)
  requestId  String @db.VarChar(100)
  userId     Int
  registerId Int
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Restrict)
  register   CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  @@id([kind, requestId])
  @@map("pos_cancellations")
}

model WebOrder {
  id             Int @id @default(autoincrement())
  reference      String @unique @db.VarChar(80)
  requestId      String @unique @db.VarChar(36)
  status         String @default("PENDING") @db.VarChar(20)
  fulfillment    String @db.VarChar(20)
  customerName   String @db.VarChar(150)
  customerPhone  String @db.VarChar(25)
  commune        String @db.VarChar(150)
  address        String @db.VarChar(500)
  notes          String @db.VarChar(1000)
  subtotalMinor  Int
  feeMinor       Int
  totalMinor     Int
  snapshot       Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  items          WebOrderItem[]
  events         WebOrderEvent[]
  attempt        CheckoutAttempt?
  @@index([status, expiresAt])
  @@map("web_orders")
}

model WebOrderItem {
  id             Int @id @default(autoincrement())
  orderId        Int
  variantId      Int
  quantity       Int
  unitPriceMinor Int
  unitCostMinor  Int
  lineTotalMinor Int
  order          WebOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@unique([orderId, variantId])
  @@map("web_order_items")
}

model WebOrderEvent {
  id        Int @id @default(autoincrement())
  orderId   Int
  userId    Int?
  kind      String @db.VarChar(30)
  reason    String @db.VarChar(500)
  createdAt DateTime @default(now())
  order     WebOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user      User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("web_order_events")
}

model CheckoutAttempt {
  requestId   String @id @db.VarChar(36)
  tokenHash   String @db.VarChar(64)
  requestHash String? @db.VarChar(64)
  state       String @db.VarChar(20)
  orderId     Int? @unique
  createdAt   DateTime @default(now())
  order       WebOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@map("checkout_attempts")
}
